{
  "kind": "backend",
  "title": "FastAPI + PostgreSQL",
  "backend": "fastapi",
  "db": "postgresql",
  "service": "api",
  "guides": [
    "stack-fastapi",
    "db-postgresql"
  ],
  "project": {
    "stack": {
      "backend": "FastAPI (Python 3.13)",
      "database": "PostgreSQL 17"
    },
    "db": {
      "image": "postgres:17-alpine",
      "migrate": "uv run --frozen alembic upgrade head",
      "rollback": "uv run --frozen alembic downgrade -1",
      "urlEnv": "DATABASE_URL"
    }
  },
  "gate": "uv run --frozen ruff format --check . && uv run --frozen ruff check . && uv run --frozen mypy app && uv run --frozen pytest -q",
  "tests": {
    "name": "backend",
    "code": [
      "app/**/*.py"
    ],
    "tests": [
      "tests/**/*.py"
    ]
  },
  "edits": {
    "format": [
      {
        "glob": "**/*.py",
        "run": "uv run --frozen ruff format {file}"
      }
    ],
    "lint": [
      {
        "glob": "**/*.py",
        "run": "uv run --frozen ruff check {file}"
      }
    ]
  },
  "commit": [
    {
      "glob": "**/*.py",
      "run": "uv run --frozen ruff check {files}"
    }
  ],
  "image": "api",
  "conformance": {
    "migration": "uv run --frozen alembic revision -m conformance-probe && uv run --frozen alembic upgrade head && uv run --frozen alembic downgrade base && uv run --frozen alembic upgrade head",
    "prodEnv": {
      "DATABASE_URL": "postgresql+asyncpg://app:app@db:5432/app"
    }
  }
}
