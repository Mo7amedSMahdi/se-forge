{
  "kind": "mobile",
  "title": "Flutter",
  "mobile": "flutter",
  "service": "mobile",
  "image": "mobile",
  "guides": [
    "stack-flutter"
  ],
  "project": {
    "stack": {
      "mobile": "Flutter (Dart)"
    }
  },
  "gate": "dart format --output=none --set-exit-if-changed lib test integration_test && flutter analyze --fatal-infos && flutter test",
  "tests": {
    "name": "mobile",
    "code": [
      "lib/**/*.dart"
    ],
    "tests": [
      "test/**/*_test.dart"
    ],
    "ignore": [
      "lib/api/**",
      "lib/l10n/app_localizations*.dart",
      "**/*.g.dart",
      "**/*.freezed.dart"
    ]
  },
  "e2e": {
    "tests": [
      "integration_test/**"
    ],
    "command": "docker compose --profile e2e run --rm -T integration"
  },
  "api": {
    "generate": "docker compose run --rm -T -v {spec}:/contract/openapi.yaml:ro mobile sh -c 'rm -rf lib/api && dart run swagger_parser && dart run build_runner build -d && dart format lib/api'",
    "out": "lib/api",
    "inFolder": true
  },
  "edits": {
    "format": [
      {
        "glob": "{lib,test,integration_test}/**/*.dart",
        "run": "dart format {file}"
      }
    ]
  }
}
